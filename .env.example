# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Remote CV URL (e.g. your live portfolio URL or GitHub Raw URL)
# When set, the agent automatically syncs with the newest CV pushed to your portfolio
CV_REMOTE_URL=https://your-portfolio.vercel.app/Mahdi-Al-Sabeh%20CV.pdf

# Optional: override model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: Server port (default: 7860 locally, Render sets PORT automatically)
PORT=7860
